generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  CASHIER
}

enum TransactionType {
  ONLINE_BOOKING
  WALK_IN
  UNKNOWN_BOOKING
  PRODUCT_SALE
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentDirection {
  INCOME
  OUTGOING
}

enum PaymentSource {
  BOOKING
  EXPENSE
  PURCHASE
  SALE
  WASTAGE
}

enum BookingType {
  ONLINE_PLAYHOUSE
  WALKIN_PLAYHOUSE
  ONLINE_BIRTHDAY
  WALKIN_BIRTHDAY
  UNKNOWN
}

enum CheckInStatus {
  CHECKED_IN
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_REVERSAL
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  RECEIVED
  PARTIALLY_PAID
  PAID
}

enum ItemCategory {
  CAFE_ITEM
  BIRTHDAY_ITEM
  OTHER_ITEM
  SERVICE_ITEM
  BIRTHDAY_PACKAGE
  PLAYHOUSE_PACKAGE
  OTHER_PACKAGE
}

model Branch {
  id                 String                @id @default(uuid()) @db.Uuid
  jaskids_branch_id  String?               @unique @db.Uuid
  name               String
  address            String?
  phone              String?
  is_active          Boolean               @default(true)
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt
  staff              Staff[]
  bookings           Booking[]
  transactions       Transaction[]
  checkins           CheckIn[]
  audit_logs         AuditLog[]
  stock_batches      StockBatch[]
  stock_movements    StockMovement[]
  supplier_purchases SupplierPurchase[]
  suppliers          Supplier[]
  products           Product[]
  sales              Sale[]
  expenses           BranchExpense[]
  payments           Payment[]

  @@map("branches")
}

model Staff {
  id                       String                @id @default(uuid()) @db.Uuid
  name                     String
  email                    String                @unique
  password_hash            String
  role                     Role
  is_active                Boolean               @default(true)
  branch_id                String?               @db.Uuid
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt
  branch                   Branch?               @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  sessions                 Session[]
  imported_bookings        Booking[]             @relation("ImportedBy")
  transactions             Transaction[]
  checkins                 CheckIn[]
  audit_logs               AuditLog[]
  stock_batches            StockBatch[]
  stock_movements          StockMovement[]
  supplier_purchases       SupplierPurchase[]
  sales                    Sale[]                @relation("SaleCashier")
  cancelled_sales          Sale[]                @relation("SaleCancelledBy")
  recorded_expenses        BranchExpense[]
  payments                 Payment[]

  @@map("staff")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  staff_id   String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  staff      Staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Booking {
  id                      String         @id @default(uuid()) @db.Uuid
  external_booking_id     String?        @unique
  reference_no            String         @unique
  qr_hash                 String         @unique
  booking_type            BookingType    @default(UNKNOWN)
  branch_id               String         @db.Uuid
  parent_name             String
  parent_phone            String?
  baby_name               String?
  child_count             Int            @default(1)
  booking_date            DateTime       @db.Date
  start_time              String
  end_time                String
  slot_name               String?
  service_name            String?
  total_price             Decimal        @db.Decimal(12, 2)
  amount_paid_at_import   Decimal        @default(0) @db.Decimal(12, 2)
  amount_due_at_import    Decimal        @default(0) @db.Decimal(12, 2)
  external_payment_status String
  external_payment_method String?
  external_status         String
  external_qr_status      String
  source_payload          Json
  imported_by             String         @db.Uuid
  imported_at             DateTime       @default(now())
  refreshed_at            DateTime       @updatedAt
  branch                  Branch         @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  importer                Staff          @relation("ImportedBy", fields: [imported_by], references: [id], onDelete: Restrict)
  children                BookingChild[]
  items                   BookingItem[]
  checkin                 CheckIn?
  payments                Payment[]

  @@index([branch_id, booking_date])
  @@index([external_status])
  @@map("bookings")
}

model BookingItem {
  id            String       @id @default(uuid()) @db.Uuid
  booking_id    String       @db.Uuid
  product_id    String?      @db.Uuid
  item_name     String
  item_category ItemCategory
  quantity      Decimal      @db.Decimal(12, 3)
  unit_price    Decimal      @db.Decimal(12, 2)
  line_total    Decimal      @db.Decimal(12, 2)
  created_at    DateTime     @default(now())
  booking       Booking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  product       Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([booking_id])
  @@index([product_id])
  @@map("booking_items")
}

model BookingChild {
  id            String    @id @default(uuid()) @db.Uuid
  booking_id    String    @db.Uuid
  position      Int
  name          String
  date_of_birth DateTime? @db.Date
  age_category  String?
  booking       Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@unique([booking_id, position])
  @@map("booking_children")
}

model CheckIn {
  id               String         @id @default(uuid()) @db.Uuid
  booking_id       String         @unique @db.Uuid
  branch_id        String         @db.Uuid
  checked_in_by    String         @db.Uuid
  checked_in_at    DateTime       @default(now())
  amount_collected Decimal        @default(0) @db.Decimal(12, 2)
  payment_method   PaymentMethod?
  status           CheckInStatus  @default(CHECKED_IN)
  note             String?
  booking          Booking        @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  branch           Branch         @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  staff            Staff          @relation(fields: [checked_in_by], references: [id], onDelete: Restrict)
  transaction      Transaction?
  payments         Payment[]

  @@index([branch_id, checked_in_at])
  @@map("checkins")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  staff_id    String?  @db.Uuid
  branch_id   String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  old_value   Json?
  new_value   Json?
  created_at  DateTime @default(now())
  staff       Staff?   @relation(fields: [staff_id], references: [id], onDelete: SetNull)
  branch      Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([branch_id, created_at])
  @@map("audit_logs")
}

model Transaction {
  id                  String               @id @default(uuid()) @db.Uuid
  receipt_no          String               @unique
  branch_id           String               @db.Uuid
  type                TransactionType
  checkin_id          String?              @unique @db.Uuid
  sale_id             String?              @unique @db.Uuid
  customer_name       String?
  customer_phone      String?
  subtotal            Decimal              @db.Decimal(10, 2)
  discount            Decimal              @default(0) @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  amount_received     Decimal              @default(0) @db.Decimal(10, 2)
  change_given        Decimal              @default(0) @db.Decimal(10, 2)
  payment_method      PaymentMethod
  payment_status      PaymentStatus
  note                String?
  staff_id            String               @db.Uuid
  created_at          DateTime             @default(now())
  branch              Branch               @relation(fields: [branch_id], references: [id])
  checkin             CheckIn?             @relation(fields: [checkin_id], references: [id], onDelete: SetNull)
  sale                Sale?                @relation(fields: [sale_id], references: [id], onDelete: SetNull)
  staff               Staff                @relation(fields: [staff_id], references: [id])
  receipt             Receipt?

  @@map("transactions")
}

model Receipt {
  id             String      @id @default(uuid()) @db.Uuid
  transaction_id String      @unique @db.Uuid
  receipt_no     String      @unique
  printed_at     DateTime?
  created_at     DateTime    @default(now())
  transaction    Transaction @relation(fields: [transaction_id], references: [id])

  @@map("receipts")
}

model Product {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  item_category       ItemCategory           @default(CAFE_ITEM)
  selling_price       Decimal?               @db.Decimal(12, 2)
  branch_id           String?                @db.Uuid
  is_active           Boolean                @default(true)
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  branch              Branch?                @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  stock_batches       StockBatch[]
  stock_movements     StockMovement[]
  purchase_items      SupplierPurchaseItem[]
  sale_items          SaleItem[]
  booking_items       BookingItem[]

  @@index([item_category, is_active])
  @@index([branch_id, item_category, is_active])
  @@map("products")
}

model Sale {
  id                  String        @id @default(uuid()) @db.Uuid
  sale_no             String        @unique
  branch_id           String        @db.Uuid
  cashier_id          String        @db.Uuid
  subtotal            Decimal       @db.Decimal(12, 2)
  discount            Decimal       @default(0) @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  amount_received     Decimal       @db.Decimal(12, 2)
  change_given        Decimal       @default(0) @db.Decimal(12, 2)
  payment_method      PaymentMethod
  status              SaleStatus    @default(COMPLETED)
  idempotency_key     String        @unique
  created_at          DateTime      @default(now())
  cancelled_at        DateTime?
  cancelled_by        String?       @db.Uuid
  cancellation_reason String?
  branch              Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  cashier             Staff         @relation("SaleCashier", fields: [cashier_id], references: [id], onDelete: Restrict)
  cancelled_by_staff  Staff?        @relation("SaleCancelledBy", fields: [cancelled_by], references: [id], onDelete: Restrict)
  items               SaleItem[]
  transaction         Transaction?
  payments            Payment[]

  @@index([branch_id, created_at])
  @@index([cashier_id, created_at])
  @@map("sales")
}

model SaleItem {
  id             String      @id @default(uuid()) @db.Uuid
  sale_id        String      @db.Uuid
  product_id     String      @db.Uuid
  stock_batch_id String?     @db.Uuid
  product_name   String
  quantity       Decimal     @db.Decimal(12, 3)
  unit_price     Decimal     @db.Decimal(12, 2)
  unit_cost      Decimal     @db.Decimal(12, 2)
  line_total     Decimal     @db.Decimal(12, 2)
  sale           Sale        @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)
  stock_batch    StockBatch? @relation(fields: [stock_batch_id], references: [id], onDelete: SetNull)

  @@index([sale_id])
  @@index([product_id])
  @@index([stock_batch_id])
  @@map("sale_items")
}

model StockBatch {
  id                     String                @id @default(uuid()) @db.Uuid
  branch_id              String                @db.Uuid
  product_id             String                @db.Uuid
  supplier_purchase_item_id String?             @unique @db.Uuid
  quantity_received      Decimal               @db.Decimal(12, 3)
  quantity_remaining     Decimal               @db.Decimal(12, 3)
  buying_price           Decimal               @db.Decimal(12, 2)
  selling_price          Decimal               @db.Decimal(12, 2)
  received_by            String                @db.Uuid
  received_at            DateTime              @default(now())
  created_at             DateTime              @default(now())
  branch                 Branch                @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  product                Product               @relation(fields: [product_id], references: [id], onDelete: Restrict)
  supplier_purchase_item SupplierPurchaseItem? @relation(fields: [supplier_purchase_item_id], references: [id], onDelete: SetNull)
  staff                  Staff                 @relation(fields: [received_by], references: [id], onDelete: Restrict)
  sale_items             SaleItem[]

  @@index([branch_id, product_id])
  @@index([branch_id, quantity_remaining])
  @@map("stock_batches")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  branch_id      String            @db.Uuid
  product_id     String            @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  unit_cost      Decimal?          @db.Decimal(12, 2)
  selling_price  Decimal?          @db.Decimal(12, 2)
  reference_type String?
  reference_id   String?
  note           String?
  performed_by   String            @db.Uuid
  created_at     DateTime          @default(now())
  branch         Branch            @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  product        Product           @relation(fields: [product_id], references: [id], onDelete: Restrict)
  staff          Staff             @relation(fields: [performed_by], references: [id], onDelete: Restrict)
  wastage_payments Payment[]        @relation("WastagePayment")

  @@index([branch_id, created_at])
  @@index([product_id, created_at])
  @@map("stock_movements")
}

model Supplier {
  id             String             @id @default(uuid()) @db.Uuid
  branch_id      String?            @db.Uuid
  name           String
  contact_person String?
  phone          String?
  email          String?
  address        String?
  is_active      Boolean            @default(true)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  branch         Branch?            @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  purchases      SupplierPurchase[]

  @@index([name])
  @@index([branch_id])
  @@map("suppliers")
}

model SupplierPurchase {
  id           String                 @id @default(uuid()) @db.Uuid
  purchase_no  String                 @unique
  supplier_id  String                 @db.Uuid
  branch_id    String                 @db.Uuid
  status       PurchaseStatus         @default(RECEIVED)
  total        Decimal                @db.Decimal(12, 2)
  amount_paid  Decimal                @default(0) @db.Decimal(12, 2)
  balance_due  Decimal                @db.Decimal(12, 2)
  note         String?
  purchased_at DateTime               @default(now())
  created_by   String                 @db.Uuid
  created_at   DateTime               @default(now())
  supplier     Supplier               @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  branch       Branch                 @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  staff        Staff                  @relation(fields: [created_by], references: [id], onDelete: Restrict)
  items        SupplierPurchaseItem[]
  payments     Payment[]

  @@index([supplier_id, purchased_at])
  @@index([branch_id, purchased_at])
  @@map("supplier_purchases")
}

model SupplierPurchaseItem {
  id          String           @id @default(uuid()) @db.Uuid
  purchase_id String           @db.Uuid
  product_id  String           @db.Uuid
  quantity    Decimal          @db.Decimal(12, 3)
  unit_cost   Decimal          @db.Decimal(12, 2)
  selling_price Decimal         @db.Decimal(12, 2)
  line_total  Decimal          @db.Decimal(12, 2)
  purchase    SupplierPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
  stock_batch StockBatch?

  @@index([purchase_id])
  @@index([product_id])
  @@map("supplier_purchase_items")
}

model ExpenseType {
  id       String          @id @default(uuid()) @db.Uuid
  name     String          @unique
  expenses BranchExpense[]

  @@map("expense_types")
}

model BranchExpense {
  id                  String               @id @default(uuid()) @db.Uuid
  branch_id           String               @db.Uuid
  expense_type_id     String               @db.Uuid
  description         String
  amount              Decimal              @db.Decimal(12, 2)
  recorded_by         String               @db.Uuid
  incurred_at         DateTime             @default(now())
  created_at          DateTime             @default(now())
  branch              Branch               @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  expense_type        ExpenseType          @relation(fields: [expense_type_id], references: [id], onDelete: Restrict)
  staff               Staff                @relation(fields: [recorded_by], references: [id], onDelete: Restrict)
  payments            Payment[]

  @@index([branch_id, incurred_at])
  @@index([expense_type_id])
  @@map("branch_expenses")
}

model Payment {
  id              String           @id @default(uuid()) @db.Uuid
  branch_id       String           @db.Uuid
  direction       PaymentDirection
  source          PaymentSource
  amount          Decimal          @db.Decimal(12, 2)
  method          PaymentMethod
  reference       String?
  note            String?
  booking_id      String?          @db.Uuid
  checkin_id      String?          @db.Uuid
  expense_id      String?          @db.Uuid
  purchase_id     String?          @db.Uuid
  sale_id         String?          @db.Uuid
  wastage_id      String?          @db.Uuid
  paid_by         String           @db.Uuid
  paid_at         DateTime         @default(now())
  created_at      DateTime         @default(now())
  branch          Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  booking         Booking?         @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  checkin         CheckIn?         @relation(fields: [checkin_id], references: [id], onDelete: Restrict)
  expense         BranchExpense?   @relation(fields: [expense_id], references: [id], onDelete: Restrict)
  purchase        SupplierPurchase? @relation(fields: [purchase_id], references: [id], onDelete: Restrict)
  sale            Sale?            @relation(fields: [sale_id], references: [id], onDelete: Restrict)
  wastage         StockMovement?   @relation("WastagePayment", fields: [wastage_id], references: [id], onDelete: Restrict)
  staff           Staff            @relation(fields: [paid_by], references: [id], onDelete: Restrict)

  @@index([branch_id, paid_at])
  @@index([source, paid_at])
  @@index([booking_id])
  @@index([expense_id])
  @@index([purchase_id])
  @@index([sale_id])
  @@index([wastage_id])
  @@map("payments")
}
